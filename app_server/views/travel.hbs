{{> header}}

<div class="container">
  <div class="row">
    <div class="col-12">
      <h1>Travel</h1>
      <p>Choose from our carefully curated travel packages below.</p>
    </div>
  </div>

  <div class="row">
    {{! Iterate over each trip object passed from the controller }}
    {{#each trips}}
    <div class="col-md-4 mb-4">
      <div class="card h-100">
        <img
          class="card-img-top"
          src="/images/{{image}}"
          alt="{{name}}"
        />
        <div class="card-body">
          <h5 class="card-title">{{name}}</h5>
          <p class="card-text">{{description}}</p>
        </div>
        <ul class="list-group list-group-flush">
          <li class="list-group-item"><strong>Code:</strong> {{code}}</li>
          <li class="list-group-item"><strong>Length:</strong> {{length}}</li>
          <li class="list-group-item"><strong>Starts:</strong> {{start}}</li>
          <li class="list-group-item"><strong>Resort:</strong> {{resort}}</li>
          <li class="list-group-item"><strong>Per Person:</strong> ${{perPerson}}</li>
        </ul>
        <div class="card-footer">
          <a href="#" class="btn btn-primary">Book Now</a>
        </div>
      </div>
    </div>
    {{/each}}
  </div>
</div>

{{> footer}}